# Copia este archivo como backend/.env y completa los valores de tu proyecto de Supabase
# (Project Settings > API). Nunca subas backend/.env al repositorio.

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon / publishable). El backend la usa para iniciar sesión.
SUPABASE_ANON_KEY=tu-clave-anon

# Clave secreta (service_role / secret). SOLO para el backend: nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role

# Entorno de ejecución: development, test o production.
# Con production el backend exige las variables de Supabase y nunca usa el modo local.
APP_ENV=development

# Persistencia de proyectos. Déjala vacía para guardar en Supabase con las variables de arriba.
# Con "local" los proyectos se guardan solo en memoria y se pierden al reiniciar (pruebas);
# no se permite junto con APP_ENV=production. Las pruebas de pytest la fijan solas en tests/conftest.py.
SKILLFISI_PERSISTENCE=
