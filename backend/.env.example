# Copia este archivo como backend/.env y completa los valores de tu proyecto de Supabase
# (Project Settings > API). Nunca subas backend/.env al repositorio.

# URL del proyecto de Supabase
SUPABASE_URL=https://tu-proyecto.supabase.co

# Clave pública (anon / publishable). El backend la usa para iniciar sesión.
SUPABASE_ANON_KEY=tu-clave-anon

# Clave secreta (service_role / secret). SOLO para el backend: nunca en el frontend.
SUPABASE_SERVICE_ROLE_KEY=tu-clave-service-role
